# Copy this file to ".env" and fill in values.
# Do NOT commit your real .env with secrets.

# Webhook for job/hiring opportunity alerts
JOBS_WEBHOOK_URL="https://discord.com/api/webhooks/XXXX/YYYY"

# Webhook for status/startup/restart logs (optional; defaults to JOBS_WEBHOOK_URL if not set)
#STATUS_WEBHOOK_URL="https://discord.com/api/webhooks/XXXX/YYYY"

# Post a webhook "started OK" message each time you run main.py (default: 1)
#STARTUP_TEST_WEBHOOK=1

# Post a webhook "stopped/offline" message when main.py exits (default: 1)
#SHUTDOWN_LOG_WEBHOOK=1

# Periodic "still alive" embed to STATUS webhook (default: on, every 300s). If heartbeats stop ~10+ min, process is likely dead.
#STATUS_HEARTBEAT_WEBHOOK=1
#STATUS_HEARTBEAT_SECONDS=300

# --- Option A: single account token ---
#DISCORD_TOKEN="YOUR_DISCORD_USER_TOKEN"
#DISCORD_ACCOUNT_NAME="Main Account"

# --- Option B: multiple account tokens (JSON array) ---
# Must be ONE line in .env (python-dotenv does not support multi-line values here)
#DISCORD_TOKENS_JSON=[{"name":"Main Account","token":"TOKEN_1"},{"name":"Alt Account","token":"TOKEN_2"}]

# --- Optional: admin commands (uses your monitor token; not a Bot API) ---
# CMD_CHANNEL_ID=123456789012345678   # optional: omit to allow !commands in any channel; if set, that channel never emits job webhooks
# CMD_OPERATOR_USER_IDS=111111111111111111,222222222222222222
# Optional: restrict commands to one server (right-click server -> Copy Server ID)
# CMD_GUILD_ID=987654321098765432
# Exactly one user token that runs !commands (recommended). Must match a token string in DISCORD_TOKENS_JSON, OR use alone as an extra login (commands only; no job webhooks).
# Typo alias also accepted: CMD_OPREATOR_TOKEN
# CMD_OPERATOR_TOKEN=YOUR_USER_TOKEN_FOR_COMMANDS_ONLY
# If CMD_OPERATOR_TOKEN is not set: use CMD_HANDLER_ACCOUNT_NAME or the first token in DISCORD_TOKENS_JSON as handler.
# CMD_HANDLER_ACCOUNT_NAME=Main Account
# CMD_PREFIX=!
# Treat the handler token’s own Discord user as admin (default 1). Set 0 to require CMD_OPERATOR_USER_IDS only.
# CMD_SELF_ADMIN=1
# Restart the whole app when .env is saved (default 1). Set 0 to disable.
# ENV_AUTO_RESTART=1
# ENV_AUTO_RESTART_GRACE_SECONDS=15
# ENV_AUTO_RESTART_POLL_SECONDS=2

# Allow job alerts on messages from the monitor account itself (for self-tests). Default: 0
# ALERT_ON_OWN_MESSAGES=1
