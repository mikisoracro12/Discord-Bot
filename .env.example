DISCORD_BOT_TOKEN=
SOURCE_CHANNEL_IDS=
DESTINATION_CHANNEL_ID=
DATABASE_URL=sqlite+aiosqlite:///tasks.db
TASK_THRESHOLD=55
HIGH_CONFIDENCE_THRESHOLD=85

# AI classification (Ollama Cloud / OpenAI-compatible)
# Create a key at https://ollama.com/settings/keys
# Budget is optional — AI accepts developer/hiring tasks without a shown price.
AI_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://ollama.com/v1
AI_MODEL=gemma4:31b
AI_PREFILTER_THRESHOLD=15
AI_TIMEOUT_SECONDS=30
